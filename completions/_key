#compdef key

typeset -ga _key_commands
_key_commands=(
  'init:create a new vault and use it on this Mac'
  'config:read or update config values'
  'status:explain vault health'
  'conflict:review conflicting entries and choose what to keep'
  'share:add another Mac or manage vault access'
  'get:print a secret'
  'copy:copy a secret to the clipboard'
  'add:add a new secret from stdin or prompt'
  'edit:update a secret from stdin or prompt'
  'duplicate:duplicate an entry'
  'rename:rename an entry'
  'remove:remove a secret'
  'list:list stored secrets'
  'migrate:check or migrate an older vault'
  'unlock:unlock the vault before running other commands'
  'lock:lock the vault on this Mac'
  'version:print the CLI version'
  'help:show this help'
)

_key_vault_root() {
  local vault_root

  vault_root="$(command key config get vault-dir 2>/dev/null)"
  [[ -n "${vault_root}" ]] || return 1

  while [[ "${vault_root}" != "/" && "${vault_root}" == */ ]]; do
    vault_root="${vault_root%/}"
  done

  print -r -- "${vault_root}"
}

_key_collect_entries() {
  local vault_root
  local -a entries

  vault_root="$(_key_vault_root)"
  [[ -d "${vault_root}" ]] || return 1

  entries=("${(@f)$(command find -L "${vault_root}" -type f -name '*.secret' -print 2>/dev/null | sed -e "s#^${vault_root}/##" -e 's/\.secret$//' | LC_ALL=C sort -u)}")
  (( ${#entries[@]} )) || return 1

  print -rl -- "${entries[@]}"
}

_key_collect_paths() {
  local vault_root
  local -a paths

  vault_root="$(_key_vault_root)"
  [[ -d "${vault_root}" ]] || return 1

  paths=("${(@f)$(command find -L "${vault_root}" \( -type d -o -type f -name '*.secret' \) -print 2>/dev/null | sed -e "s#^${vault_root}\$##" -e "s#^${vault_root}/##" -e 's/\.secret$//' -e '/^$/d' -e '/\.secret$/d' | LC_ALL=C sort -u)}")
  (( ${#paths[@]} )) || return 1

  print -rl -- "${paths[@]}"
}

_key_complete_entries() {
  local expl
  local -a entries

  entries=("${(@f)$(_key_collect_entries)}") || return 1
  _wanted key-entries expl 'key entry' compadd -Q -a entries
}

_key_complete_paths() {
  local expl
  local -a paths

  paths=("${(@f)$(_key_collect_paths)}") || return 1
  _wanted key-paths expl 'key path' compadd -Q -a paths
}

local curcontext="$curcontext" state line
typeset -A opt_args

_arguments -C \
  '1:command:->command' \
  '*::arg:->args'

case "${state}" in
  command)
    _describe -t commands 'key command' _key_commands
    ;;
  args)
    if (( CURRENT == 2 )) && [[ "${words[1]}" != help ]]; then
      compadd -- -h --help
    fi
    case "${words[1]}" in
      init)
        _arguments '(-h --help)'{-h,--help}'[show setup instructions]' '1:directory:_files -/'
        ;;
      config)
        if (( CURRENT == 2 )); then
          _describe -t config-commands 'config command' \
            'get:print a config value' \
            'set:update a config value' \
            'list:list config values'
        else
          case "${words[2]}" in
            get)
              _arguments \
                '1:key:(vault-dir)'
              ;;
            set)
              _arguments \
                '1:key:(vault-dir)' \
                '2:path:_files -/'
              ;;
            list)
              ;;
          esac
        fi
        ;;
      get)
        _arguments \
          '--allow-stale[read the last complete trusted version while newer files are unavailable]' \
          '1:entry:_key_complete_entries'
        ;;
      copy)
        _arguments \
          '--allow-stale[read the last complete trusted version while newer files are unavailable]' \
          '1:entry:_key_complete_entries'
        ;;
      status)
        _arguments \
          '--json[print stable machine-readable status]' \
          '--verbose[include storage format and verified-history identifiers]'
        ;;
      conflict)
        if (( CURRENT == 2 )); then
          _describe -t conflict-commands 'conflict command' \
            'list:list unresolved content conflicts' \
            'show:show verified versions of a conflict' \
            'get:print one conflicted secret version' \
            'copy:copy one conflicted secret version' \
            'resolve:resolve every current conflict together'
        else
          case "${words[2]}" in
            list)
              _arguments \
                '--json[print stable machine-readable conflict summaries]'
              ;;
            show)
              _arguments \
                '--json[print stable machine-readable conflict detail]' \
                '1:conflict ID:'
              ;;
            get|copy)
              _arguments \
                '1:conflict ID:' \
                '2:version ID:'
              ;;
            resolve)
              _arguments \
                '*:resolution in conflict-id=version-id form:'
              ;;
          esac
        fi
        ;;
      share)
        if (( CURRENT == 2 )); then
          _describe -t share-commands 'share command' \
            'devices:list Macs recorded for this vault' \
            'revoke:review and remove a Mac from the vault' \
            'invitations:list short-lived vault invitations' \
            'invite:invite another Mac' \
            'join:request access from this Mac' \
            'requests:list answers to an invitation' \
            'compare:compare one device pair' \
            'approve:approve the compared joining Mac' \
            'accept:finish joining the approved vault'
        else
          case "${words[2]}" in
            devices)
              _arguments \
                '--json[print stable machine-readable device inventory]'
              ;;
            revoke)
              _arguments '1:device ID:'
              ;;
            invitations)
              _arguments '--vault-dir[existing vault folder]:directory:_files -/'
              ;;
            invite)
              _arguments \
                '--name[existing name of the Mac creating the invitation]:device name:'
              ;;
            join)
              _arguments \
                '1:invitation ID:' \
                '--name[name to give this joining Mac]:device name:' \
                '--vault-dir[existing vault folder]:directory:_files -/'
              ;;
            requests)
              _arguments \
                '1:invitation ID:'
              ;;
            compare)
              _arguments \
                '1:vault ID:' \
                '2:invitation ID:' \
                '3:join request ID:' \
                '--vault-dir[existing vault folder]:directory:_files -/'
              ;;
            approve)
              _arguments \
                '1:vault ID:' \
                '2:invitation ID:' \
                '3:comparison code:'
              ;;
            accept)
              _arguments \
                '1:vault ID:' \
                '2:invitation ID:' \
                '3:comparison code:' \
                '--vault-dir[existing vault folder]:directory:_files -/'
              ;;
          esac
        fi
        ;;
      add)
        _arguments \
          '--totp[store a Base32 authenticator setup secret]' \
          '1:path:_key_complete_paths'
        ;;
      edit)
        _arguments \
          '--totp[store a Base32 authenticator setup secret]' \
          '1:entry:_key_complete_entries'
        ;;
      duplicate)
        _arguments \
          '1:source entry:_key_complete_entries' \
          '2:destination path:_key_complete_paths' \
          '--force[overwrite an existing destination]'
        ;;
      rename)
        _arguments \
          '1:source entry:_key_complete_entries' \
          '2:destination path:_key_complete_paths' \
          '--force[overwrite an existing destination]'
        ;;
      remove)
        _arguments \
          '1:entry:_key_complete_entries' \
          '--force[skip the confirmation prompt]'
        ;;
      migrate)
        _arguments \
          '--check[check readiness without changing the vault]' \
          '--apply[create and verify a migrated copy, then use it on this Mac]'
        ;;
      list|unlock|lock)
        ;;
      version)
        _arguments \
          '--json[print version info as JSON]'
        ;;
      help)
        local -a help_topics
        help_topics=("${(@)_key_commands:#help:*}")
        _describe -t commands 'help topic' help_topics
        ;;
    esac
    ;;
esac
