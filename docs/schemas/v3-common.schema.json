{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tvanreenen/key/main/docs/schemas/v3-common.schema.json",
  "title": "Key Vault v3 common values",
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "deviceID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "p256X963PublicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{87}$"
    },
    "p256RawSignature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "possiblyEmptyBase64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$"
    },
    "entryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "entryType": {
      "type": "string",
      "enum": [
        "secret",
        "totp"
      ]
    }
  }
}
