{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tvanreenen/key/main/docs/schemas/v3-manifest-body.schema.json",
  "title": "Key Vault v3 manifest body",
  "description": "The canonical body authenticated by the envelope selected in FMT-202.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "vaultID",
    "mode",
    "keyID",
    "devices",
    "wrappedKeys",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "key-vault-manifest"
    },
    "version": {
      "const": 3
    },
    "vaultID": {
      "$ref": "v3-common.schema.json#/$defs/uuid"
    },
    "mode": {
      "type": "string",
      "enum": [
        "local",
        "shared"
      ]
    },
    "keyID": {
      "$ref": "v3-common.schema.json#/$defs/vaultKeyID"
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "wrappedKeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wrappedKey"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceID",
        "displayName",
        "role",
        "status",
        "signingPublicKey",
        "wrappingPublicKey"
      ],
      "properties": {
        "deviceID": {
          "$ref": "v3-common.schema.json#/$defs/deviceID"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "member"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked"
          ]
        },
        "signingPublicKey": {
          "$ref": "#/$defs/signingPublicKey"
        },
        "wrappingPublicKey": {
          "$ref": "#/$defs/wrappingPublicKey"
        }
      }
    },
    "signingPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "P-256-ECDSA"
        },
        "encoding": {
          "const": "x963"
        },
        "value": {
          "$ref": "v3-common.schema.json#/$defs/p256X963PublicKey"
        }
      }
    },
    "wrappingPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "P-256-ECDH"
        },
        "encoding": {
          "const": "x963"
        },
        "value": {
          "$ref": "v3-common.schema.json#/$defs/p256X963PublicKey"
        }
      }
    },
    "wrappedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceID",
        "algorithm",
        "ciphertext"
      ],
      "properties": {
        "deviceID": {
          "$ref": "v3-common.schema.json#/$defs/deviceID"
        },
        "algorithm": {
          "const": "p256-ecies-x963-sha256-aes-gcm"
        },
        "ciphertext": {
          "$ref": "v3-common.schema.json#/$defs/base64url"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryID",
        "name",
        "type",
        "revision",
        "keyID",
        "ciphertextDigest"
      ],
      "properties": {
        "entryID": {
          "$ref": "v3-common.schema.json#/$defs/uuid"
        },
        "name": {
          "$ref": "v3-common.schema.json#/$defs/entryName"
        },
        "type": {
          "$ref": "v3-common.schema.json#/$defs/entryType"
        },
        "revision": {
          "$ref": "v3-common.schema.json#/$defs/positiveSafeInteger"
        },
        "keyID": {
          "$ref": "v3-common.schema.json#/$defs/vaultKeyID"
        },
        "ciphertextDigest": {
          "$ref": "v3-common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
