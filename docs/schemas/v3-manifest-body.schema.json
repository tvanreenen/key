{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tvanreenen/key/main/docs/schemas/v3-manifest-body.schema.json",
  "title": "Key Vault v3 role-free device-wrapped manifest body",
  "description": "The canonical profileVersion 2 body authenticated by the version 3 envelope. Array ordering, roster/wrapper coverage, key derivation, public-key validity and uniqueness, canonical Unicode, and canonical JSON are enforced by the normative codec in addition to this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "profile",
    "profileVersion",
    "vaultID",
    "keyID",
    "authorityTransitionID",
    "hpkeSuite",
    "devices",
    "wrappedKeys",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "key-vault-manifest"
    },
    "version": {
      "const": 3
    },
    "profile": {
      "const": "device-wrapped"
    },
    "profileVersion": {
      "const": 2
    },
    "vaultID": {
      "$ref": "v3-common.schema.json#/$defs/uuid"
    },
    "keyID": {
      "$ref": "v3-common.schema.json#/$defs/vaultKeyID"
    },
    "authorityTransitionID": {
      "$ref": "v3-common.schema.json#/$defs/uuid"
    },
    "hpkeSuite": {
      "$ref": "#/$defs/hpkeSuite"
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "wrappedKeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wrappedKey"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "hpkeSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "kem",
        "kdf",
        "aead"
      ],
      "properties": {
        "mode": {
          "const": 0
        },
        "kem": {
          "const": 16
        },
        "kdf": {
          "const": 1
        },
        "aead": {
          "const": 2
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceID",
        "displayName",
        "status",
        "signingPublicKey",
        "wrappingPublicKey"
      ],
      "properties": {
        "deviceID": {
          "$ref": "v3-common.schema.json#/$defs/deviceID"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "revoked"
          ]
        },
        "signingPublicKey": {
          "$ref": "#/$defs/signingPublicKey"
        },
        "wrappingPublicKey": {
          "$ref": "#/$defs/wrappingPublicKey"
        }
      }
    },
    "signingPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "P-256-ECDSA"
        },
        "encoding": {
          "const": "x963"
        },
        "value": {
          "$ref": "v3-common.schema.json#/$defs/p256X963PublicKey"
        }
      }
    },
    "wrappingPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "P-256-ECDH"
        },
        "encoding": {
          "const": "x963"
        },
        "value": {
          "$ref": "v3-common.schema.json#/$defs/p256X963PublicKey"
        }
      }
    },
    "wrappedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipientDeviceID",
        "encapsulatedKey",
        "ciphertext"
      ],
      "properties": {
        "recipientDeviceID": {
          "$ref": "v3-common.schema.json#/$defs/deviceID"
        },
        "encapsulatedKey": {
          "$ref": "v3-common.schema.json#/$defs/hpkeP256EncapsulatedKey"
        },
        "ciphertext": {
          "$ref": "v3-common.schema.json#/$defs/hpkeAESGCM256WrappedVaultKey"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryID",
        "name",
        "type",
        "revision",
        "keyID",
        "ciphertextDigest"
      ],
      "properties": {
        "entryID": {
          "$ref": "v3-common.schema.json#/$defs/uuid"
        },
        "name": {
          "$ref": "v3-common.schema.json#/$defs/entryName"
        },
        "type": {
          "$ref": "v3-common.schema.json#/$defs/entryType"
        },
        "revision": {
          "$ref": "v3-common.schema.json#/$defs/positiveSafeInteger"
        },
        "keyID": {
          "$ref": "v3-common.schema.json#/$defs/vaultKeyID"
        },
        "ciphertextDigest": {
          "$ref": "v3-common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
