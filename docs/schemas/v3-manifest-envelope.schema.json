{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tvanreenen/key/main/docs/schemas/v3-manifest-envelope.schema.json",
  "title": "Key Vault v3 authenticated manifest envelope",
  "description": "The canonical envelope for the role-free device-wrapped manifest profile. Parent and authorization ordering, canonical low-S signatures, and canonical JSON are enforced by the normative codec in addition to this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "content",
    "authentication",
    "authorizations"
  ],
  "properties": {
    "format": {
      "const": "key-vault-manifest-envelope"
    },
    "version": {
      "const": 3
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "authentication": {
      "$ref": "#/$defs/authentication"
    },
    "authorizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/authorization"
      }
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parents",
        "manifest"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "v3-common.schema.json#/$defs/sha256"
          }
        },
        "manifest": {
          "$ref": "v3-manifest-body.schema.json"
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "tag"
      ],
      "properties": {
        "algorithm": {
          "const": "HKDF-SHA256+HMAC-SHA256"
        },
        "tag": {
          "$ref": "v3-common.schema.json#/$defs/sha256"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "signerDeviceID",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "P-256-ECDSA-SHA256"
        },
        "signerDeviceID": {
          "$ref": "v3-common.schema.json#/$defs/deviceID"
        },
        "signature": {
          "$ref": "v3-common.schema.json#/$defs/p256RawSignature"
        }
      }
    }
  }
}
